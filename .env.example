# Copy to .env.production and fill in before a release build (`npm run build`).
# Unset ad units fall back to Google's test units with test mode on.
VITE_ADMOB_IOS_BANNER=
VITE_ADMOB_IOS_INTERSTITIAL=
VITE_ADMOB_IOS_REWARDED=
VITE_ADMOB_ANDROID_BANNER=
VITE_ADMOB_ANDROID_INTERSTITIAL=
VITE_ADMOB_ANDROID_REWARDED=
# RevenueCat public SDK keys (appl_... / goog_...). Unset = no Remove Ads purchase.
VITE_RC_IOS_KEY=
VITE_RC_ANDROID_KEY=
# Hosted privacy policy URL (required by both stores and AdMob).
VITE_PRIVACY_URL=
